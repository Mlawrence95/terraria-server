# Set like:
# crontab /path/to/this/file

# See existing crontab config like,
# crontab -l

# See system logs:
# grep CRON /var/log/syslog

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/games:/usr/games
CRON_TZ=America/Los_Angeles
TZ=America/Los_Angeles


# Check for game updates every 30 minutes
*/30 * * * * echo "$(date) - Running version check" >> $HOME/terraria/terraria-server/cron.log; $HOME/terraria/terraria-server/scripts/chores/check_latest_version.sh >> $HOME/terraria/terraria-server/cron.log 2>&1

# Restart server at 5am every day.
0 5 * * * echo "$(date) - Starting server reboot process" >> $HOME/terraria/terraria-server/cron.log; $HOME/terraria/terraria-server/scripts/chores/nightly_reboot.sh >> $HOME/terraria/terraria-server/cron.log 2>&1

# Ping the server with water reminders every 30 minutes
*/30 * * * * echo "$(date) - Water break" >> $HOME/terraria/terraria-server/cron.log; $HOME/terraria/terraria-server/scripts/chores/water_reminder.sh >> $HOME/terraria/terraria-server/cron.log 2>&1


# Dump env debug info to disk
# * * * * * env | sort > /tmp/cron.env

# * * * * *  command_to_run
# - - - - -
# | | | | |
# | | | | +---- Day of the week (0-7, where 0 and 7 are Sunday)
# | | | +------ Month (1-12)
# | | +-------- Day of the month (1-31)
# | +---------- Hour (0-23)
# +------------ Minute (0-59)
# */K means "run every K <unit>" and a static number is that literal time.
