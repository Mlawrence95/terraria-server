# Set like:
# crontab /path/to/this/file

# See existing crontab config like,
# crontab -l

# See system logs:
# grep CRON /var/log/syslog

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/games:/usr/games

# Check for game updates every night at 5 AM
*/2 * * * * echo "$(TZ=America/Los_Angeles date) - Running version check" >> $HOME/terraria/terraria-server/version_check.log; $HOME/terraria/terraria-server/scripts/check_latest_version.sh >> $HOME/terraria/terraria-server/version_check.log 2>&1

# Dump debug info to disk
* * * * * env | sort > /tmp/cron.env

# * * * * *  command_to_run
# - - - - -
# | | | | |
# | | | | +---- Day of the week (0-7, where 0 and 7 are Sunday)
# | | | +------ Month (1-12)
# | | +-------- Day of the month (1-31)
# | +---------- Hour (0-23)
# +------------ Minute (0-59)
# */K means "run every K <unit>" and a static number is that literal time.
